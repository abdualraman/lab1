# Exercise 1
with open("exercise1_input.txt", "w") as f:
    f.write("Hello world!\nWelcome to Python File I/O lab.\nHappy coding!")

lines = 0
words = 0

with open("exercise1_input.txt", "r") as f:
    for line in f:
        lines += 1
        words += len(line.split())

print("Total Lines:", lines)
print("Total Words:", words)

